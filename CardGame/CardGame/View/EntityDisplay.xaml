<UserControl x:Class="CardGame.View.EntityDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CardGame.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="2*"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Content="{Binding Name}" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Label Content="{Binding Image}" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Label Content="{Binding Health}" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Content="{Binding NextMove}" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
